generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  avatarUrl    String?
  role         Role     @default(USER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  videos       Video[]
  streams      Stream[]
  donations    Donation[]
}

model Category {
  id   String @id @default(cuid())
  name String @unique
  slug String @unique
  videos Video[]
}

enum VideoStatus {
  PROCESSING
  READY
  FAILED
}

model Video {
  id           String      @id @default(cuid())
  title        String
  description  String?
  publicId     String?     @unique
  videoUrl     String
  thumbnailUrl String?
  duration     Int         @default(0)
  status       VideoStatus @default(READY)
  viewCount    Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  // Quan hệ: mỗi video thuộc 1 uploader và (tuỳ chọn) 1 danh mục
  uploader   User      @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  uploaderId String
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId String?
  streams    Stream[]

  // Chỉ mục cho các truy vấn thường dùng; KHÔNG đánh chỉ mục status (ít giá trị khác nhau)
  @@index([uploaderId])
  @@index([categoryId])
  @@index([createdAt])
  @@index([viewCount])
}

enum StreamStatus {
  CREATED
  PLAYING
  PAUSED
  ENDED
}

model Stream {
  id             String       @id @default(cuid())
  title          String
  status         StreamStatus @default(CREATED)
  requireAuth    Boolean      @default(false)
  donationOverlay Json        @default("{\"x\":20,\"y\":5,\"width\":60,\"height\":30}")
  positionMs     Int          @default(0)
  stateChangedAt DateTime?
  startedAt      DateTime?
  endedAt        DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  owner          User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId        String
  video          Video        @relation(fields: [videoId], references: [id], onDelete: Cascade)
  videoId        String
  samples        StreamSample[]
  donations      Donation[]

  @@index([ownerId, createdAt])
  @@index([videoId])
  @@index([status, createdAt])
}

model StreamSample {
  id         String   @id @default(cuid())
  ts         DateTime @default(now())
  viewers    Int
  positionMs Int

  stream     Stream   @relation(fields: [streamId], references: [id], onDelete: Cascade)
  streamId   String

  @@unique([streamId, ts])
  @@index([streamId, ts])
}

model Donation {
  id        String   @id @default(cuid())
  amount    Int
  message   String   @default("")
  requestId String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  stream    Stream   @relation(fields: [streamId], references: [id], onDelete: Cascade)
  streamId  String

  @@unique([userId, requestId])
  @@index([streamId, createdAt])
}
