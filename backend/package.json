{
    "name": "streamhub-backend",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "node --watch --env-file=.env src/server.js",
        "start": "node src/server.js",
        "postinstall": "prisma generate",
        "db:generate": "prisma generate",
        "db:migrate": "prisma migrate dev",
        "db:seed": "node --env-file=.env prisma/seed.mjs",
        "db:studio": "prisma studio"
    },
    "dependencies": {
        "@prisma/client": "^6.19.3",
        "bcryptjs": "^3.0.3",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.6",
        "express": "^5.2.1",
        "helmet": "^8.3.0",
        "ioredis": "^6.0.0",
        "jose": "^6.2.12",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "prisma": "^6.19.3"
    },
    "allowScripts": {
        "@prisma/client@6.19.3": true,
        "@prisma/engines@6.19.3": true,
        "prisma@6.19.3": true
    }
}
